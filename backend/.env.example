NODE_ENV=development
PORT=4000

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://modhub:modhub@localhost:5432/modhub?schema=public"

# MongoDB (Mongoose)
MONGO_URL="mongodb://localhost:27017/modhub"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50

# CORS
FRONTEND_URL="http://localhost:5173"
